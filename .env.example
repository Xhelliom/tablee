# Copier en .env — jamais commité (voir .gitignore).

# Base de données. L'app et les migrations lisent la même variable.
DATABASE_URL=postgres://tablee:motdepasse@localhost:5432/tablee

# Signe les jetons de session, 32 caractères au moins. Obligatoire : le serveur
# refuse de démarrer sans, plutôt que de tourner avec une clé partagée. En générer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TABLEE_SECRET=

# Clé API Anthropic (V3) : « Découper avec l'IA » dans la saisie libre, l'onglet
# « Conseils » et « Demander à l'assistant des recettes » sur l'accueil. Absente,
# rien de tout ça. Serveur uniquement : elle ne doit jamais atteindre le bundle
# client (R4). Ce qui part : le texte tapé et un résumé de la semaine, sans les
# prénoms du foyer ni les jetons Jow — voir server/llm/index.ts et la dette n° 17.
# ANTHROPIC_API_KEY=sk-ant-…
# Le modèle de ces trois usages. Facultatif : claude-sonnet-5 par défaut. Il doit
# accepter `effort`, la sortie structurée et le repli côté serveur.
# TABLEE_LLM_MODEL=claude-sonnet-5

# Envoi de mail : invitations, mot de passe oublié, confirmation d'adresse.
# Sans TABLEE_MAIL, rien ne part — les invitations restent des liens à copier,
# et un mot de passe oublié se règle en base (dette n° 7). Avec, toute adresse
# doit être confirmée avant d'entrer, comptes existants compris : un lien leur
# part à leur prochaine connexion.
# Le transporteur voit l'adresse, le prénom de qui invite et le nom du foyer.
# TABLEE_MAIL=resend            # ou smtp
# TABLEE_MAIL_FROM='Tablée <tablee@example.net>'
# RESEND_API_KEY=re_…           # avec resend : domaine vérifié chez Resend
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.net:465   # avec smtp ;
#   smtp://…:587 pour STARTTLS. Encoder @ / : # dans le mot de passe.

# Connexion Google : les deux, ou aucune. Client OAuth « Application Web » de
# la console Google Cloud, URI de redirection autorisée :
#   <TABLEE_BASE_URL>/api/auth/callback/google
# Une adresse déjà inscrite par mot de passe n'est reliée à Google que si elle
# a été confirmée (TABLEE_MAIL) ; sinon, elle le lie depuis les réglages du foyer.
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-…

# Base dédiée aux tests d'intégration. Sans elle, les suites qui touchent à
# Postgres sont sautées — avec un message, pas en silence.
#   createdb tablee_test && npm run migrate
# TEST_DATABASE_URL=postgres://tablee:motdepasse@localhost:5432/tablee_test

# Développement en local sur http://localhost : le cookie de session est posé
# sans l'attribut Secure. À ne jamais renseigner en production — le share
# target Android exige HTTPS de toute façon (§4).
# TABLEE_INSECURE_COOKIE=1

# L'origine publique, telle que le navigateur la voit — http://localhost:3000 par
# défaut. Avec `npm run dev:web`, c'est Vite qui sert la page : sans cette ligne,
# better-auth refuse toute action une fois connecté (« Invalid origin »).
# En production, le nom de domaine.
# TABLEE_BASE_URL=http://localhost:5173
