# Copier en .env — jamais commité (voir .gitignore).

# Base de données. L'app et les migrations lisent la même variable.
DATABASE_URL=postgres://tablee:motdepasse@localhost:5432/tablee

# Clé API du LLM (V3). Serveur uniquement : elle ne doit jamais atteindre le
# bundle client (R4).
# LLM_API_KEY=

# Envoi de mail : invitations, mot de passe oublié, confirmation d'adresse.
# Sans TABLEE_MAIL, rien ne part — les invitations restent des liens à copier,
# et un mot de passe oublié se règle en base (dette n° 7). Avec, toute adresse
# doit être confirmée avant d'entrer, comptes existants compris : un lien leur
# part à leur prochaine connexion.
# Le transporteur voit l'adresse, le prénom de qui invite et le nom du foyer.
# TABLEE_MAIL=resend            # ou smtp
# TABLEE_MAIL_FROM='Tablée <tablee@example.net>'
# RESEND_API_KEY=re_…           # avec resend : domaine vérifié chez Resend
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.net:465   # avec smtp ;
#   smtp://…:587 pour STARTTLS. Encoder @ / : # dans le mot de passe.

# Base dédiée aux tests d'intégration. Sans elle, les suites qui touchent à
# Postgres sont sautées — avec un message, pas en silence.
#   createdb tablee_test && npm run migrate
# TEST_DATABASE_URL=postgres://tablee:motdepasse@localhost:5432/tablee_test

# Développement en local sur http://localhost : le cookie de session est posé
# sans l'attribut Secure. À ne jamais renseigner en production — le share
# target Android exige HTTPS de toute façon (§4).
# TABLEE_INSECURE_COOKIE=1
