  "tip": {
   "author": {
    "_id": "64536f48ad85324a719cb499",
    "id": "64536f48ad85324a719cb499",
    "__v": 0,
    "createdAt": "2023-05-04T08:39:36.135Z",
    "name": "Un client astucieux",
    "updatedAt": "2023-05-04T08:39:36.135Z",
    "imageUrl": null
   },
   "description": "Pour un repas zéro-déchet, utilisez les verts de poireaux pour faire une soupe ! Rincez-les bien, puis retirez les parties abimées, séchées & jaunies avant de les ajouter dans une casserole avec les ingrédients de votre choix.",
   "type": {
    "_id": "645123f770ae101d47660e48",
    "id": "645123f770ae101d47660e48",
    "__v": 0,
    "createdAt": "2023-05-02T14:53:43.188Z",
    "name": "zero-waste-tip",
    "title": "♻️ Astuce anti-gaspi",
    "updatedAt": "2023-05-17T12:19:42.963Z"
   }
  },
  "title": "Risotto aux poireaux",
  "updatedAt": "2026-04-24T10:07:43.021Z",
  "userConstituentsIds": [],
  "difficulty": 1,
  "directions": [
   {
    "id": "5c10e7b1dfc71302916fdfb3",
    "label": "Faire bouillir 25cl d'eau par personne et y dissoudre le bouillon de légumes.",
    "videoTimecodeStart": 9.1,
    "involvedIngredients": [
     {
      "id": "5bd995c70d276400042146c2",
      "name": "Bouillon de légumes (cube)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/HTSOH60mYB28jA.png.webp"
     }
    ]
   },
   {
    "id": "5c10e7b1dfc71302916fdfb1",
    "label": "Coupez les extrémités des poireaux* pour ne gardez que le blanc puis émincez finement. Placez dans une passoire et rincez abondamment pour retirer les impuretés. \n*Consultez nos tips pour cette étape",
    "videoTimecodeStart": 14.4,
    "involvedIngredients": [
     {
      "id": "59ec940ed2dfbb0012bc5399",
      "name": "Poireau",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/EjlbNB1DecIorw.png.webp"
     }
    ]
   },
   {
    "id": "5c10e7b1dfc71302916fdfb0",
    "label": "Dans une grande poêle, ajoutez les poireaux égouttés à sec (sans matière grasse) et faire revenir à feu vif pendant 2 minutes en remuant. Ajoutez l'équivalent d'une louche du bouillon et laissez cuire 2 minutes de plus. ",
    "videoTimecodeStart": 27.9,
    "involvedIngredients": [
     {
      "id": "59ec940ed2dfbb0012bc5399",
      "name": "Poireau",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/EjlbNB1DecIorw.png.webp"
     }
    ]
   },
   {
    "id": "5c10e7b1dfc71302916fdfaf",
    "label": "Ajoutez 1 louche de bouillon, le riz et le vin blanc (optionnel). Laissez évaporer puis ajoutez une nouvelle louche de bouillon.",
    "videoTimecodeStart": 32.5,
    "involvedIngredients": [
     {
      "id": "59fa477ed6de9c00121aa1ef",
      "name": "Riz (Arborio)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/AGQfy1uRWlE43g.png.webp"
     },
     {
      "id": "59e8aac15c929200124854a8",
      "name": "Vin blanc",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/opvGYcbHocNPKg.png.webp"
     }
    ]
   },
   {
    "id": "5f43ecb00a8f77102f4dc375",
    "label": "Faire de même jusqu'à ce qu'il n'y ai plus de bouillon de légumes. Au bout de 18/20 minutes, le riz doit être cuit. ",
    "videoTimecodeStart": 45.5,
    "involvedIngredients": []
   },
   {
    "id": "5c10e7b1dfc71302916fdfae",
    "label": "Si au bout de 20 minutes le riz n'est pas encore assez cuit, rajouter encore un peu d'eau et prolonger la cuisson. Une fois la cuisson terminée, ajoutez le parmesan, le beurre, (optionnel : un peu de crème pour les gourmands), sel, poivre et mélangez le tout.",
    "videoTimecodeStart": 74.7,
    "involvedIngredients": [
     {
      "id": "5b80035d05fcd900044fdfb7",
      "name": "Parmesan (râpé)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/HmFH0IM4TS9RbA.png.webp"
     },
     {
      "id": "59eb9e2440250c00129d9819",
      "name": "Beurre",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/enheudgtrxVpfw.png.webp"
     }
    ]
   },
   {
    "id": "5c110d6538a077302959ef51",
    "label": "Servir le risotto dans les assiettes, salez, poivrez, c'est prêt !",
    "videoTimecodeStart": 98.4,
    "involvedIngredients": []
   }
  ],
