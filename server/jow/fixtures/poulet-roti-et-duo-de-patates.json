     }
    ]
   },
   {
    "id": "59ebab7040250c00129d982f",
    "label": "Dans un plat allant au four, disposez le poulet, les pommes de terre et les patates douces, les échalotes, le bouquet garni.",
    "videoTimecodeStart": 26,
    "involvedIngredients": [
     {
      "id": "59eb9d2640250c00129d980e",
      "name": "Poulet (entier)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/lnc28T3dsuTvrQ.png.webp"
