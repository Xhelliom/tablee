     }
    ]
   },
   {
    "id": "5f3d36453baafc106452191f",
    "label": "Épluchez et coupez les échalotes en 2. ",
    "videoTimecodeStart": 19.8,
    "involvedIngredients": [
     {
      "id": "59b851d18b98250012a9b613",
      "name": "Échalote",
