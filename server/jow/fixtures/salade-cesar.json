  "title": "Salade César",
  "updatedAt": "2026-08-26T09:01:21.092Z",
  "userConstituentsIds": [],
  "difficulty": 2,
  "directions": [
   {
    "id": "602ad9313c51b43c76a65e8a",
    "label": "Préparez le filet de poulet. Astuce : pour avoir une peau bien dorée, roulez le filet de poulet dans la farine avant de le cuire. ",
    "videoTimecodeStart": 9.1,
    "involvedIngredients": [
     {
      "id": "598b40ecfd078b00111409fb",
      "name": "Poulet (escalope)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/jUGG6OsEGasgIQ.png.webp"
     }
    ]
   },
   {
    "id": "602ad9313c51b43c76a65e8c",
    "label": "Faites chauffer un filet d'huile ou une noisette de beurre dans une poêle. Ajoutez le poulet et faites-le dorer 2 minutes à feu vif sur une première face. Salez et poivrez. ",
    "videoTimecodeStart": 16.4,
    "involvedIngredients": [
     {
      "id": "598b40ecfd078b00111409fb",
      "name": "Poulet (escalope)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/jUGG6OsEGasgIQ.png.webp"
     }
    ]
   },
   {
    "id": "602ad9313c51b43c76a65e8e",
    "label": "Retournez le poulet sur l'autre face et faites-le cuire 8 minutes à feu moyen. Continuez d'arroser, salez et poivrez.",
    "videoTimecodeStart": 28.8,
    "involvedIngredients": []
   },
   {
    "id": "602ad9d43c51b43c76a65f1c",
    "label": "Pendant ce temps, coupez les tranches de pain en croûtons. Réservez. ",
    "videoTimecodeStart": 33.9,
    "involvedIngredients": [
     {
      "id": "59b40868cc5d6a001237264e",
      "name": "Pain de campagne (tranché)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/xo9IZ0IebS8kXw.jpg.webp"
     }
    ]
   },
   {
    "id": "602ad9313c51b43c76a65e85",
    "label": "Préparez la sauce. Dans un récipient haut ou un bol, ajoutez l'œuf entier et la moutarde. Salez et poivrez. ",
    "videoTimecodeStart": 41.7,
    "involvedIngredients": [
     {
      "id": "598f2f9cc966e50011d5a520",
      "name": "Moutarde",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/V7TnFdO70TCnPw.jpg.webp"
     },
     {
      "id": "59822caadfcf6c00119298a3",
      "name": "Œuf",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/II4OHUKzp3sEkw.png.webp"
     }
    ]
   },
   {
    "id": "602ad9313c51b43c76a65e86",
    "label": "Mixer votre préparation puis ajoutez l'huile en filet petit à petit (soit 140g pour un œuf). Mixez de bas en haut.",
    "videoTimecodeStart": 55.1,
    "involvedIngredients": [
     {
      "id": "5a4fa13ea23db20014c73305",
      "name": "Huile de tournesol",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/elFhhzjlKPmcHg.png.webp"
     }
    ]
   },
   {
    "id": "602e61a49abeee0e9f91c108",
    "label": "La sauce doit épaissir au fur et à mesure que vous versez l'huile. Astuce : si votre huile a tranché, versez une goutte d'eau froide et mixez.",
    "videoTimecodeStart": 65.5,
    "involvedIngredients": []
   },
   {
    "id": "602ad9313c51b43c76a65e87",
    "label": "Ajoutez la gousse d'ail et râpez une partie du parmesan en le râpant au-dessus du saladier. (Vous pouvez en garder un morceau pour faire quelques copeaux fins pour le dressage). ",
    "videoTimecodeStart": 76.1,
    "involvedIngredients": [
     {
      "id": "598b5ebefd078b0011140a17",
      "name": "Ail",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/b3FOqn5Ql1fjOQ.png.webp"
     },
     {
      "id": "598b651ffd078b0011140a21",
      "name": "Parmesan (morceaux)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/ZABijQZrwz8mhw.png.webp"
     }
    ]
   },
   {
    "id": "602ad9313c51b43c76a65e8d",
    "label": "Continuez de mixer. La sauce est prête. Vous pouvez ajuster la consistance avec un peu d'eau. ",
    "videoTimecodeStart": 86,
