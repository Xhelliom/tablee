  "difficulty": 2,
  "directions": [
   {
    "id": "5a6f320ded87b60014de393c",
    "label": "Lavez puis coupez les courgettes en tagliatelle, à l'aide d'un économe.",
    "videoTimecodeStart": 9.1,
    "involvedIngredients": [
     {
      "id": "59921cc3e9f1de001116bbb9",
      "name": "Courgette",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/iEufjCnqLmFLsw.jpg.webp"
     }
    ]
   },
   {
    "id": "6895c0ce7911587f9606da5d",
    "label": "Épluchez puis coupez les carottes en tagliatelle, à l'aide d'un économe.",
    "videoTimecodeStart": 20.7,
    "involvedIngredients": [
     {
      "id": "59921cf6e9f1de001116bbba",
      "name": "Carotte (frais)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/YUaixjyeR2w4gA.jpg.webp"
     }
    ]
   },
   {
    "id": "5a6f320ded87b60014de393b",
    "label": "Préchauffez le four à 180°C. Dans un saladier, mélangez la crème et l'œuf. Salez, poivrez et ajoutez les épices de votre choix - ex: thym, origan ou piment d'Espelette.",
    "videoTimecodeStart": 37.9,
    "involvedIngredients": [
     {
      "id": "59bcf8ccdd23e80012730717",
      "name": "Crème liquide",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/nv0Qq8FZ3fcgQQ.jpg.webp"
     },
     {
      "id": "59822caadfcf6c00119298a3",
      "name": "Œuf",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/II4OHUKzp3sEkw.png.webp"
     }
    ]
   },
   {
    "id": "5a6f320ded87b60014de393a",
    "label": "Disposez la pâte brisée dans un moule à tarte (le nôtre fait 31 cm de diamètre). Piquez la pâte et étalez la moutarde à l'ancienne*. Placez les légumes sur leurs tranches à partir du bord en alternant : un tour de courgettes, un tour de carottes.\n*Consultez nos tips pour cette étape",
    "videoTimecodeStart": 55.2,
    "involvedIngredients": [
     {
      "id": "59bcfb44dd23e8001273071e",
      "name": "Pâte brisée",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/00Peuj0b30Di8A.png.webp"
     },
     {
      "id": "59921cc3e9f1de001116bbb9",
      "name": "Courgette",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/iEufjCnqLmFLsw.jpg.webp"
     },
     {
      "id": "59921cf6e9f1de001116bbba",
      "name": "Carotte (frais)",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/YUaixjyeR2w4gA.jpg.webp"
     },
     {
      "id": "59bcfdcbdd23e80012730728",
      "name": "Moutarde à l'ancienne",
      "imageUrl": "https://static.jow.fr/160x160/ingredients/4qPV6EgvK96NGA.jpg.webp"
     }
    ]
   },
   {
    "id": "5a6f320ded87b60014de3939",
    "label": "Versez le mélange de crème sur la tarte. Salez, poivrez et enfournez pendant 50 à 55 minutes à 180°C.",
    "videoTimecodeStart": 107.4,
    "involvedIngredients": []
   },
