{
  "name": "tablee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 \"server/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "jow:resolve": "node --import tsx scripts/jow-resolve.ts",
    "jow:capture": "node --import tsx scripts/jow-capture.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed:food": "node --env-file-if-exists=.env --import tsx scripts/seed-food.ts",
    "start": "node --import tsx server/index.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "test:db": "node --import tsx --test --test-concurrency=1 \"server/**/*.test.ts\"",
    "dev:web": "vite",
    "build:web": "vite build",
    "icons": "node --import tsx scripts/make-icons.ts",
    "seed:refs": "node --env-file-if-exists=.env --import tsx scripts/seed-refs.ts",
    "seed": "npm run seed:food && npm run seed:refs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "better-auth": "^1.7.4",
    "fastify": "^5.12.4",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.2"
  }
}
